# Copy to .env. Never commit real values.

# docker compose: password for the bundled PostgreSQL.
POSTGRES_PASSWORD=change-me
# PostgreSQL memory, about 1/4 and 2/3 of the server's RAM (defaults 3GB / 8GB).
# PG_SHARED_BUFFERS=3GB
# PG_EFFECTIVE_CACHE_SIZE=8GB

# Running outside docker compose (local development):
SHARP_EYES_DATABASE_URL=postgresql+psycopg://sharp_eyes:sharp_eyes@localhost:5432/sharp_eyes
SHARP_EYES_CONFIG=config/default.yaml

# Venue credentials are optional and unused in paper mode.
# SHARP_EYES_KALSHI_API_KEY_ID=
# SHARP_EYES_KALSHI_PRIVATE_KEY_PATH=
# SHARP_EYES_NOVIG_KEY_ID=
# SHARP_EYES_NOVIG_PRIVATE_KEY_PATH=
# SHARP_EYES_POLYMARKET_US_API_KEY=
